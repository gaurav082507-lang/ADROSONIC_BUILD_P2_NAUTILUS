VITE_API_BASE_URL=/api/v1
# 1 = Mock Service Worker with provisional fixtures; 0 = real backend (use 0 for the demo)
VITE_USE_MOCKS=1
# Comma list of backend features to show: voice,network,analytics,story
# Empty + mocks on = all on. Empty + mocks off = all off.
VITE_FEATURES=
# Demo accounts prefilled on the login page – set to match the backend seed
VITE_DEMO_INVESTIGATOR_EMAIL=investigator@demo.in
VITE_DEMO_CLAIMANT_EMAIL=ravi@demo.in
VITE_DEMO_PASSWORD=demo
